<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
  ═══════════════════════════════════════════════════════════════════════════════
  PMCR-O — AgentService
  Identity  : MAF agent host — PMCRO loop (Orchestrator→Planner→Maker→Checker→Reflector)
  Law Anchor: EC-018 (CPM — no Version attrs), OLS-001 (OllamaSharp only), ThoughtLock: 2026-05-30
  ═══════════════════════════════════════════════════════════════════════════════
  TargetFramework, Nullable, ImplicitUsings inherited from Directory.Build.props.
  NoWarn:
    MAAI001       — MAF preview API surface
    MAESKILLS001  — MAF Agent Skills preview
    EXTEXP0001    — Microsoft.Extensions.AI experimental APIs
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>495ac912-b168-4ca0-898c-4d88821842a9</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..\..</DockerfileContext>
    <LangVersion>preview</LangVersion>
    <NoWarn>$(NoWarn);MAAI001;MAESKILLS001;EXTEXP0001</NoWarn>
  </PropertyGroup>

  <!-- MAF -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting" />
    <PackageReference Include="Microsoft.Agents.AI.DevUI" />
    <PackageReference Include="NJsonSchema" />
  </ItemGroup>

  <!-- Ollama — OLS-001: never use Microsoft.Extensions.AI.Ollama -->
  <ItemGroup>
    <PackageReference Include="OllamaSharp" />
  </ItemGroup>

  <!-- MCP -->
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

  <!-- gRPC -->
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Observability + Service Discovery -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
  </ItemGroup>

  <!-- Proto -->
  <ItemGroup>
    <Protobuf Include="Protos\agents.proto" GrpcServices="Server" />
  </ItemGroup>

  <!-- ServiceDefaults -->
  <ItemGroup>
    <ProjectReference Include="..\..\ProjectName.ServiceDefaults\ProjectName.ServiceDefaults.csproj" />
  </ItemGroup>

  <!-- Skills — copy the repo-level skills tree into the output directory.
       AgentSkillsProviderBuilder resolves paths at runtime against AppContext.BaseDirectory. -->
  <ItemGroup>
    <Content Include="..\..\..\skills\**\*.*">
      <Link>skills\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
